{
  "entities": {
    "VisitorProfile": {
      "title": "VisitorProfile",
      "description": "Authenticated visitor profile record for email-based visitor login.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Visitor email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Visitor display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was first created."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest visitor login."
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "lastLoginAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/VisitorProfile" },
      "description": "Private visitor profile document keyed by Firebase Auth UID."
    }
  }
}
