rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidVisitorProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'lastLoginAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    // Private visitor profile documents (PII strictly owner-isolated, no listing)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidVisitorProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidVisitorProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLoginAt']);

      allow delete: if false;
    }
  }
}
